@page
@model Portfolio.Pages.ExperienceModel

@{
    ViewData["Title"] = "Experience";
}

<header class="page-header">
    <span class="eyebrow">
        <svg class="icon icon-sm" aria-hidden="true">
            <use href="#icon-code"></use>
        </svg>
        // experience
    </span>

    <h1>Experience</h1>

    <p class="lede">
        10+ years building enterprise desktop, backend, integration, GIS,
        financial, healthcare, and cloud-native software solutions.
    </p>
</header>

<div class="timeline section">
    @foreach (var role in Model.Roles)
    {
        var itemClass = role.IsFeatured
        ? "timeline-item timeline-item-featured"
        : "timeline-item timeline-item-compact";

        <article class="@itemClass">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-body">
                <header class="timeline-header">
                    <h2 class="timeline-role">
                        @role.Role
                    </h2>

                    <span class="timeline-duration">
                        <svg class="icon icon-sm" aria-hidden="true">
                            <use href="#icon-calendar"></use>
                        </svg>

                        @role.Duration
                    </span>
                </header>

                <div class="timeline-company">
                    <a href="@role.CompanyUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        @role.Company

                        <svg class="icon icon-sm" aria-hidden="true">
                            <use href="#icon-external"></use>
                        </svg>
                    </a>

                    <span class="timeline-location">
                        @role.Location
                    </span>
                </div>

                <div class="timeline-project">
                    @role.ProjectTitle
                </div>

                <p class="experience-overview">
                    @role.ProjectSummary
                </p>

                @if (role.IsFeatured)
                {
                    <section class="timeline-section">
                        <h3 class="timeline-section-label">
                            What I worked on
                        </h3>

                        <ul class="contribution-list">
                            @foreach (var contribution in role.KeyContributions)
                            {
                                <li>@contribution</li>
                            }
                        </ul>
                    </section>

                    @foreach (var detail in role.DetailSections)
                    {
                        <section class="experience-detail">
                            <h3>@detail.Title</h3>

                            @foreach (var paragraph in detail.Paragraphs)
                            {
                                <p>@paragraph</p>
                            }

                            @if (detail.Points.Count > 0)
                            {
                                <ul class="experience-detail-list">
                                    @foreach (var point in detail.Points)
                                    {
                                        <li>@point</li>
                                    }
                                </ul>
                            }
                        </section>
                    }

                    @if (role.Highlights.Count > 0)
                    {
                        <section class="timeline-section">
                            <h3 class="timeline-section-label">
                                Highlights
                            </h3>

                            <div class="highlight-grid">
                                @foreach (var highlight in role.Highlights)
                                {
                                    <div class="highlight-card">
                                        <svg class="icon icon-sm"
                                             aria-hidden="true">
                                            <use href="#icon-check-circle"></use>
                                        </svg>

                                        <span>@highlight</span>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                }
                else
                {
                    <section class="timeline-section">
                        <h3 class="timeline-section-label">
                            Key contributions
                        </h3>

                        <ul class="contribution-list compact-contribution-list">
                            @foreach (var contribution in role.KeyContributions)
                            {
                                <li>@contribution</li>
                            }
                        </ul>
                    </section>
                }

                <section class="timeline-section">
                    <h3 class="timeline-section-label">
                        Tech stack
                    </h3>

                    <div class="tag-row">
                        @foreach (var technology in role.Technologies)
                        {
                            <span class="tag">@technology</span>
                        }
                    </div>
                </section>
            </div>
        </article>
    }
</div>

@if (Model.SideProjects.Count > 0)
{
    <section class="section">
        <span class="eyebrow">
            <svg class="icon icon-sm" aria-hidden="true">
                <use href="#icon-code"></use>
            </svg>
            // personal projects
        </span>

        <h2>Side projects</h2>

        <div class="card-grid">
            @foreach (var project in Model.SideProjects)
            {
                <article class="card">
                    <div class="file-name">
                        <svg class="icon icon-sm" aria-hidden="true">
                            <use href="#icon-code"></use>
                        </svg>

                        @project.FileName
                    </div>

                    <h3>@project.Title</h3>

                    <p>@project.Description</p>

                    <div class="tag-row">
                        @foreach (var tag in project.Tags)
                        {
                            <span class="tag">@tag</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(project.Link))
                    {
                        <div class="card-link">
                            <a href="@project.Link"
                               target="_blank"
                               rel="noopener noreferrer">
                                View on GitHub

                                <svg class="icon icon-sm"
                                     aria-hidden="true">
                                    <use href="#icon-external"></use>
                                </svg>
                            </a>
                        </div>
                    }
                </article>
            }
        </div>
    </section>
}

<partial name="_ScrollControls" />