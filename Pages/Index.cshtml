@page
@model Portfolio.Pages.IndexModel

@{
    ViewData["Title"] = "About";
}

<section class="home-hero">
    <span class="eyebrow">
        <svg class="icon icon-sm" aria-hidden="true">
            <use href="#icon-eye"></use>
        </svg>
        // about
    </span>

    <pre class="hero-code" aria-label="Developer profile represented as C# code"><span class="tok-keyword">public</span> <span class="tok-keyword">sealed</span> <span class="tok-keyword">class</span> <span class="tok-type">Developer</span> : <span class="tok-type">Person</span>
{
    <span class="tok-keyword">public</span> <span class="tok-type">string</span> <span class="tok-method">Name</span> => <span class="tok-string">"Ritash Koul"</span>;
    <span class="tok-keyword">public</span> <span class="tok-type">string</span> <span class="tok-method">Role</span> => <span class="tok-string">"Senior Software Developer"</span>;
    <span class="tok-keyword">public</span> <span class="tok-type">string</span> <span class="tok-method">Location</span> => <span class="tok-string">"Pune, India"</span>;
    <span class="tok-keyword">public</span> <span class="tok-type">int</span> <span class="tok-method">YearsOfExperience</span> => <span class="tok-string">10</span>;
    <span class="tok-keyword">public</span> <span class="tok-type">string</span>[] <span class="tok-method">Focus</span> =>
    [
        <span class="tok-string">"Enterprise .NET"</span>,
        <span class="tok-string">"Desktop & Backend Engineering"</span>,
        <span class="tok-string">"GIS & Distributed Systems"</span>
    ];<span class="caret"></span>
}</pre>

    <h1 class="home-title">
        Building enterprise software across desktop, backend, GIS,
        IoT, and distributed systems.
    </h1>

    <p class="lede home-lede">
        I am a Senior Software Developer with 10+ years of experience designing
        and developing enterprise applications using C#, .NET, WPF,
        ASP.NET Core, SQL Server, and event-driven technologies.
    </p>

    <p class="home-introduction">
        My experience spans GIS, financial services, healthcare, insurance,
        and utility platforms. I have worked on product modernization,
        enterprise desktop applications, REST APIs, microservices,
        Kafka-based processing, Kubernetes environments, and integrations
        with complex external systems.
    </p>

    <div class="button-row">
        <a class="btn btn-primary"
           href="/Experience">
            Explore my experience

            <svg class="icon" aria-hidden="true">
                <use href="#icon-arrow-right"></use>
            </svg>
        </a>

        <a class="btn"
           href="/Resume">
            <svg class="icon" aria-hidden="true">
                <use href="#icon-eye"></use>
            </svg>

            View resume
        </a>

        <a class="btn"
           href="~/resume/resume.pdf"
           download>
            <svg class="icon" aria-hidden="true">
                <use href="#icon-download"></use>
            </svg>

            Download PDF
        </a>
    </div>
</section>


<section class="section"
         aria-labelledby="technology-stack-title">

    <span class="eyebrow">
        <svg class="icon icon-sm" aria-hidden="true">
            <use href="#icon-tag"></use>
        </svg>
        // core technologies
    </span>

    <h2 id="technology-stack-title">
        Technology stack
    </h2>

    <div class="skill-groups">
        <section class="skill-group">
            <h3>Languages and frameworks</h3>

            <div class="chip-row">
                <span class="chip">C#</span>
                <span class="chip">.NET</span>
                <span class="chip">.NET Framework</span>
                <span class="chip">ASP.NET Core</span>
                <span class="chip">Python</span>
            </div>
        </section>

        <section class="skill-group">
            <h3>Desktop and GIS</h3>

            <div class="chip-row">
                <span class="chip">WPF</span>
                <span class="chip">MVVM</span>
                <span class="chip">ArcGIS Pro SDK</span>
                <span class="chip">ArcPy</span>
                <span class="chip">Enterprise Geodatabases</span>
            </div>
        </section>

        <section class="skill-group">
            <h3>Backend and integration</h3>

            <div class="chip-row">
                <span class="chip">REST APIs</span>
                <span class="chip">Microservices</span>
                <span class="chip">Kafka</span>
                <span class="chip">MQTT</span>
                <span class="chip">Windows Services</span>
            </div>
        </section>

        <section class="skill-group">
            <h3>Data and DevOps</h3>

            <div class="chip-row">
                <span class="chip">SQL Server</span>
                <span class="chip">PostgreSQL</span>
                <span class="chip">Docker</span>
                <span class="chip">Kubernetes</span>
                <span class="chip">Azure DevOps</span>
                <span class="chip">Git</span>
            </div>
        </section>
    </div>
</section>


<section class="section home-project-preview"
         aria-labelledby="current-work-title">

    <div class="section-heading-row">
        <div>
            <span class="eyebrow">
                <svg class="icon icon-sm" aria-hidden="true">
                    <use href="#icon-code"></use>
                </svg>
                // current work
            </span>

            <h2 id="current-work-title">
                Modernizing enterprise GIS products
            </h2>
        </div>

        <a href="/Experience"
           class="section-link">
            View full experience

            <svg class="icon icon-sm" aria-hidden="true">
                <use href="#icon-arrow-right"></use>
            </svg>
        </a>
    </div>

    <p>
        I am currently working on the modernization of Mapping and Town
        Planning products from ArcMap to ArcGIS Pro. The products are used
        by more than 100 Swedish municipalities for mapping, planning,
        infrastructure, and urban-development workflows.
    </p>

    <div class="tag-row">
        <span class="tag">C#</span>
        <span class="tag">WPF</span>
        <span class="tag">ArcGIS Pro SDK</span>
        <span class="tag">ArcPy</span>
        <span class="tag">Enterprise GIS</span>
        <span class="tag">REST APIs</span>
    </div>
</section>


<section class="section home-project-preview"
         aria-labelledby="current-focus-title">

    <div class="section-heading-row">
        <div>
            <span class="eyebrow">
                <svg class="icon icon-sm" aria-hidden="true">
                    <use href="#icon-code"></use>
                </svg>
                // current focus
            </span>

            <h2 id="current-focus-title">
                Exploring and building with AI
            </h2>
        </div>

        <a href="https://github.com/ritashkoul/DeskRAG-releases"
           target="_blank"
           rel="noopener noreferrer"
           class="section-link">
            View DeskRAG on GitHub

            <svg class="icon icon-sm" aria-hidden="true">
                <use href="#icon-external"></use>
            </svg>
        </a>
    </div>

    <p>
        Alongside my enterprise .NET and GIS work, I am exploring how
        modern AI capabilities can be integrated into real applications.
        I built DeskRAG, a Windows desktop application for semantic search
        and question answering over local documents, and I am continuing
        to evolve it while exploring RAG, local LLMs, AI agents, tooling,
        and MCP.
    </p>

    <div class="tag-row">
        <span class="tag">.NET</span>
        <span class="tag">WPF</span>
        <span class="tag">RAG</span>
        <span class="tag">Semantic Search</span>
        <span class="tag">Ollama</span>
        <span class="tag">Local LLMs</span>
        <span class="tag">AI Agents</span>
        <span class="tag">MCP</span>
    </div>
</section>


<section class="section"
         aria-labelledby="education-title">

    <span class="eyebrow">
        <svg class="icon icon-sm" aria-hidden="true">
            <use href="#icon-calendar"></use>
        </svg>
        // education
    </span>

    <h2 id="education-title">
        Education
    </h2>

    <div class="education-card">
        <div>
            <h3>
                Bachelor of Engineering in Information Technology
            </h3>

            <p>
                <a href="https://www.tcetmumbai.in/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="education-link">
                    Thakur College of Engineering and Technology

                    <svg class="icon icon-sm" aria-hidden="true">
                        <use href="#icon-external"></use>
                    </svg>
                </a>,
                University of Mumbai
            </p>
        </div>

        <span class="education-year">
            2014
        </span>
    </div>
</section>


@if (Model.DailyQuote is not null)
{
    <blockquote class="quote-of-day section">
        <p>
            &ldquo;@Model.DailyQuote.Text&rdquo;
        </p>

        <footer>
            — @Model.DailyQuote.Author
        </footer>
    </blockquote>
}

<partial name="_ScrollControls" />