@page
@model Portfolio.Pages.ResumeModel

@{
    ViewData["Title"] = "Resume";
}

<span class="eyebrow">
    <svg class="icon icon-sm" aria-hidden="true">
        <use href="#icon-download"></use>
    </svg>
    // resume.pdf
</span>

<h1>Resume</h1>

<p class="lede">
    A concise overview of my professional experience, technical skills,
    product work, and education.
</p>

<div class="resume-actions">
    <a class="btn btn-primary"
       href="~/resume/resume.pdf"
       download>

        <svg class="icon" aria-hidden="true">
            <use href="#icon-download"></use>
        </svg>

        Download PDF
    </a>

    <a class="btn"
       href="~/resume/resume.pdf"
       target="_blank"
       rel="noopener noreferrer">

        Open in new tab

        <svg class="icon" aria-hidden="true">
            <use href="#icon-external"></use>
        </svg>
    </a>

    <a class="btn"
       href="/Experience">

        Read detailed experience

        <svg class="icon" aria-hidden="true">
            <use href="#icon-arrow-right"></use>
        </svg>
    </a>
</div>

<div class="resume-note">
    <svg class="icon icon-sm" aria-hidden="true">
        <use href="#icon-eye"></use>
    </svg>

    <span>
        The resume contains the concise version. The Experience page provides
        additional product context, architecture, and engineering details.
    </span>
</div>

<div class="resume-frame section">
    <iframe src="/resume/resume.pdf"
            title="Ritash Koul resume preview"
            loading="lazy">
    </iframe>
</div>