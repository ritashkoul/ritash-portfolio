@page
@model Portfolio.Pages.ResumeModel

@{
    ViewData["Title"] = "Resume";
}

<header class="page-header">
    <span class="eyebrow">
        <svg class="icon icon-sm" aria-hidden="true">
            <use href="#icon-file-text"></use>
        </svg>
        // resume
    </span>

    <h1>Resume</h1>

    <p class="lede">
        View the resume online or download the PDF directly.
    </p>
</header>

<div class="resume-actions">
    <a class="btn btn-primary"
       href="~/resume/resume.pdf"
       download>
        <svg class="icon" aria-hidden="true">
            <use href="#icon-download"></use>
        </svg>

        Download PDF
    </a>

    <a class="btn"
       href="~/resume/resume.pdf"
       target="_blank"
       rel="noopener noreferrer">
        Open in new tab

        <svg class="icon" aria-hidden="true">
            <use href="#icon-external"></use>
        </svg>
    </a>
</div>

<section class="resume-frame section"
         aria-label="Resume preview">
    <iframe src="/resume/resume.pdf"
            title="Ritash Koul resume"
            loading="lazy">
    </iframe>
</section>

<partial name="_ScrollControls" />