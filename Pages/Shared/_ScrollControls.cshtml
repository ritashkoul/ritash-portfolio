<div class="scroll-controls"
     aria-label="Page navigation">

    <button type="button"
            id="scroll-top"
            class="scroll-control"
            title="Back to top"
            aria-label="Back to top">

        <svg class="icon"
             aria-hidden="true">
            <use href="#icon-chevron-up"></use>
        </svg>
    </button>

    <button type="button"
            id="scroll-bottom"
            class="scroll-control"
            title="Go to bottom"
            aria-label="Go to bottom">

        <svg class="icon"
             aria-hidden="true">
            <use href="#icon-chevron-down"></use>
        </svg>
    </button>

</div>