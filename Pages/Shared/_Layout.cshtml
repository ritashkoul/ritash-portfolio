@{
    var path = Context.Request.Path.Value ?? "/";

    bool IsActive(string prefix) =>
        prefix == "/"
            ? path == "/"
            : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    string TabClass(string prefix) =>
        IsActive(prefix) ? "tab active" : "tab";

    var pageTitle = ViewData["Title"]?.ToString();
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "Ritash Koul · Lead Software Developer"
        : $"{pageTitle} · Ritash Koul";

    var description =
        "Ritash Koul is a Lead Software Developer with 12+ years of experience " +
        "building enterprise applications using C#, .NET, WPF, ASP.NET Core, " +
        "ArcGIS Pro SDK, Kafka, Docker, and Kubernetes.";

    var canonicalUrl =
        $"https://ritashkoul.onrender.com{Context.Request.Path}";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@fullTitle</title>

    <meta name="description"
          content="@description" />

    <meta name="author"
          content="Ritash Koul" />

    <link rel="canonical"
          href="@canonicalUrl" />

    <meta property="og:type"
          content="website" />

    <meta property="og:title"
          content="@fullTitle" />

    <meta property="og:description"
          content="@description" />

    <meta property="og:url"
          content="@canonicalUrl" />

    <meta property="og:site_name"
          content="Ritash Koul" />

    <meta name="twitter:card"
          content="summary" />

    <meta name="twitter:title"
          content="@fullTitle" />

    <meta name="twitter:description"
          content="@description" />

    <meta name="theme-color"
          id="theme-color-meta"
          content="#171b20" />

    <link rel="icon"
          type="image/svg+xml"
          href="~/favicon.svg" />

    <script src="~/js/theme-init.js"
            asp-append-version="true"></script>

    <script type="application/ld+json"
            src="~/schema.json"></script>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <script type="text/javascript">
        (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () {
                (c[a].q = c[a].q || []).push(arguments);
            };

            t = l.createElement(r);
            t.async = 1;
            t.src = "https://www.clarity.ms/tag/" + i;

            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", "xsvztsvciw");
    </script>
</head>

<body>
    <partial name="_Icons" />

    <div class="app-window">
        <header class="tab-bar" role="banner">
            <a href="/"
               class="brand"
               aria-label="Ritash Koul home page">

                <svg class="icon" aria-hidden="true">
                    <use href="#icon-code"></use>
                </svg>
            </a>

            <nav class="tabs"
                 aria-label="Primary navigation">

                <a class="@TabClass("/")"
                   href="/"
                   aria-current="@(IsActive("/") ? "page" : null)">

                    <svg class="icon" aria-hidden="true">
                        <use href="#icon-eye"></use>
                    </svg>

                    <span>About.cshtml</span>
                </a>

                <a class="@TabClass("/Experience")"
                   href="/Experience"
                   aria-current="@(IsActive("/Experience") ? "page" : null)">

                    <svg class="icon" aria-hidden="true">
                        <use href="#icon-code"></use>
                    </svg>

                    <span>Experience.cshtml</span>
                </a>

                <a class="@TabClass("/Resume")"
                   href="/Resume"
                   aria-current="@(IsActive("/Resume") ? "page" : null)">

                    <svg class="icon" aria-hidden="true">
                        <use href="#icon-download"></use>
                    </svg>

                    <span>Resume.pdf</span>
                </a>
            </nav>

            <div class="header-actions">
                <button type="button"
                        id="theme-toggle"
                        class="btn-icon theme-toggle"
                        title="Switch theme"
                        aria-label="Switch between light and dark theme">

                    <svg class="icon icon-sun" aria-hidden="true">
                        <use href="#icon-sun"></use>
                    </svg>

                    <svg class="icon icon-moon" aria-hidden="true">
                        <use href="#icon-moon"></use>
                    </svg>
                </button>

                <a class="btn-icon"
                   href="~/resume/resume.pdf"
                   download
                   title="Download resume"
                   aria-label="Download resume as PDF">

                    <svg class="icon" aria-hidden="true">
                        <use href="#icon-download"></use>
                    </svg>
                </a>
            </div>
        </header>

        <main class="content" role="main">
            @RenderBody()
        </main>

        <footer class="status-bar" role="contentinfo">
            <div class="status-right social-links">
                <a href="https://github.com/ritashkoul"
                   target="_blank"
                   rel="noopener noreferrer">

                    <svg class="icon icon-sm" aria-hidden="true">
                        <use href="#icon-github"></use>
                    </svg>

                    GitHub
                </a>

                <a href="https://www.linkedin.com/in/ritash-koul-a7ab9050"
                   target="_blank"
                   rel="noopener noreferrer">

                    <svg class="icon icon-sm" aria-hidden="true">
                        <use href="#icon-linkedin"></use>
                    </svg>

                    LinkedIn
                </a>

                <a href="mailto:koulritash@gmail.com">
                    <svg class="icon icon-sm" aria-hidden="true">
                        <use href="#icon-mail"></use>
                    </svg>

                    Email
                </a>
            </div>
        </footer>
    </div>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>