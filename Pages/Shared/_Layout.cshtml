@{
    var path = Context.Request.Path.Value ?? "/";

    bool IsActive(string prefix) =>
        prefix == "/"
            ? path == "/"
            : path.StartsWith(
                prefix,
                StringComparison.OrdinalIgnoreCase);

    string TabClass(string prefix) =>
        IsActive(prefix)
            ? "tab active"
            : "tab";

    var pageTitle =
        ViewData["Title"]?.ToString();

    var fullTitle =
        string.IsNullOrWhiteSpace(pageTitle)
            ? "Ritash Koul · Lead Software Developer"
            : $"{pageTitle} · Ritash Koul";

    const string description =
        "Ritash Koul is a Lead Software Developer with 12+ years of " +
        "experience building enterprise applications using C#, .NET, " +
        "WPF, ASP.NET Core, ArcGIS Pro SDK, Kafka, Docker, and Kubernetes.";

    const string siteUrl =
        "https://ritashkoul.onrender.com";

    var canonicalUrl =
        $"{siteUrl}{Context.Request.Path}";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@fullTitle</title>

    <meta name="description"
          content="@description" />

    <meta name="author"
          content="Ritash Koul" />

    <link rel="canonical"
          href="@canonicalUrl" />

    <meta property="og:type"
          content="website" />

    <meta property="og:title"
          content="@fullTitle" />

    <meta property="og:description"
          content="@description" />

    <meta property="og:url"
          content="@canonicalUrl" />

    <meta property="og:site_name"
          content="Ritash Koul" />

    <meta name="twitter:card"
          content="summary" />

    <meta name="twitter:title"
          content="@fullTitle" />

    <meta name="twitter:description"
          content="@description" />

    <meta name="theme-color"
          id="theme-color-meta"
          content="#171b20" />

    <link rel="icon"
          type="image/svg+xml"
          href="~/favicon.svg" />

    <script src="~/js/theme-init.js"
            asp-append-version="true"></script>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <partial name="_Icons" />

    <a class="skip-link"
       href="#main-content">
        Skip to main content
    </a>

    <div class="app-window">
        <header class="tab-bar">

            <a asp-page="/Index"
               class="brand brand-monogram"
               aria-label="Ritash Koul home page">
                RK
            </a>

            <nav class="tabs"
                 aria-label="Primary navigation">

                <a asp-page="/Index"
                   class="@TabClass("/")"
                   aria-current="@(IsActive("/") ? "page" : null)">

                    <svg class="icon"
                         aria-hidden="true">
                        <use href="#icon-user"></use>
                    </svg>

                    <span>About</span>
                </a>

                <a asp-page="/Experience"
                   class="@TabClass("/Experience")"
                   aria-current="@(IsActive("/Experience") ? "page" : null)">

                    <svg class="icon"
                         aria-hidden="true">
                        <use href="#icon-briefcase"></use>
                    </svg>

                    <span>Experience</span>
                </a>

                <a asp-page="/Resume"
                   class="@TabClass("/Resume")"
                   aria-current="@(IsActive("/Resume") ? "page" : null)">

                    <svg class="icon"
                         aria-hidden="true">
                        <use href="#icon-file-text"></use>
                    </svg>

                    <span>Resume</span>
                </a>

            </nav>

            <div class="header-actions">
                <button type="button"
                        id="theme-toggle"
                        class="theme-toggle"
                        title="Switch theme"
                        aria-label="Switch between light and dark theme">

                    <svg class="icon icon-sun"
                         aria-hidden="true">
                        <use href="#icon-sun"></use>
                    </svg>

                    <svg class="icon icon-moon"
                         aria-hidden="true">
                        <use href="#icon-moon"></use>
                    </svg>

                </button>
            </div>

        </header>

        <main class="content"
              id="main-content">
            @RenderBody()
        </main>

        <footer class="status-bar">
            <div class="status-right social-links">

                <a href="https://github.com/ritashkoul"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="GitHub profile">

                    <svg class="icon icon-sm"
                         aria-hidden="true">
                        <use href="#icon-github"></use>
                    </svg>

                    GitHub
                </a>

                <a href="https://www.linkedin.com/in/ritash-koul-a7ab9050"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="LinkedIn profile">

                    <svg class="icon icon-sm"
                         aria-hidden="true">
                        <use href="#icon-linkedin"></use>
                    </svg>

                    LinkedIn
                </a>

                <a href="https://www.instagram.com/koulheadedritesh/"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Instagram profile">

                    <svg class="icon icon-sm"
                         aria-hidden="true">
                        <use href="#icon-instagram"></use>
                    </svg>

                    Instagram
                </a>

                <a href="mailto:koulritash@gmail.com"
                   aria-label="Send email">

                    <svg class="icon icon-sm"
                         aria-hidden="true">
                        <use href="#icon-mail"></use>
                    </svg>

                    Email
                </a>

            </div>
        </footer>
    </div>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)
</body>
</html>